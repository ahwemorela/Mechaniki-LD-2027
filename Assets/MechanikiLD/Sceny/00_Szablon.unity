    - target: {fileID: 8511088242910486180, guid: 62afe0ded6f836d4ca7fd518c7868e3b, type: 3}
      propertyPath: tekst
      value: "JAK TO PRZEROBI\u0106\nWszystko, co robi dany obiekt, jest w jego Inspektorze:
        zachowanie, teksty komunikat\xF3w, d\u017Awi\u0119ki.\nPuste pole tekstu
        = brak komunikatu.\nKolory mechanik: menu Mechaniki LD > Ustawienia. Interfejs:
        Mechaniki LD > Edytuj interfejs.\nSzczeg\xF3\u0142y: Dokumentacja/08_Dostosowywanie."
      objectReference: {fileID: 0}
    - target: {fileID: 8511088242910486180, guid: 62afe0ded6f836d4ca7fd518c7868e3b, type: 3}
      propertyPath: kolor.b
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8511088242910486180, guid: 62afe0ded6f836d4ca7fd518c7868e3b, type: 3}
