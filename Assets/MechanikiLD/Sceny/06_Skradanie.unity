      objectReference: {fileID: 0}
    - target: {fileID: 8511088242910486180, guid: 62afe0ded6f836d4ca7fd518c7868e3b, type: 3}
      propertyPath: tekst
      value: "DWA ROZWI\u0104ZANIA\n1) przemkn\u0105\u0107 mi\u0119dzy os\u0142onami
        w rytm kamery,\n2) przej\u015B\u0107 pod tyln\u0105 \u015Bcian\u0105 (poza
        zasi\u0119giem \u015Bwiat\u0142a) do prze\u0142\u0105cznika za os\u0142on\u0105
        i wy\u0142\u0105czy\u0107 kamer\u0119.\nReakcja kamery = Tylko Sygna\u0142:
        kara to stracony czas (drzwi zamkni\u0119te 5 s), a nie powr\xF3t do punktu
        kontrolnego."
      objectReference: {fileID: 0}
