    - target: {fileID: 8511088242910486180, guid: 62afe0ded6f836d4ca7fd518c7868e3b, type: 3}
      propertyPath: tekst
      value: "JAK TO PRZEROBI\u0106\nTEKSTY: zaznacz drzwi i zobacz sekcj\u0119 \"Komunikaty
        i d\u017Awi\u0119ki\". Te czerwone maj\u0105 teksty domy\u015Blne (\"Otwarto
        kluczem: {0}\"). Zmie\u0144 je albo wyczy\u015B\u0107 pole \u2013 pusty tekst
        = brak komunikatu. {0} to nazwa klucza."
      objectReference: {fileID: 0}
