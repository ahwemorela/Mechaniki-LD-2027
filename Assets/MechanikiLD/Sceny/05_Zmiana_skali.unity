    - target: {fileID: 8511088242910486180, guid: 62afe0ded6f836d4ca7fd518c7868e3b, type: 3}
      propertyPath: tekst
      value: "JAK TO PRZEROBI\u0106\nPRZEDMIOT: pole \"Skala\" (0.3 / 2.5 / 1 to
        tylko przyk\u0142ady \u2013 spr\xF3buj 0.5 i 1.5), \"Czas Trwania\" > 0 daje
        efekt chwilowy z odliczaniem, \"Czas Odnowienia\" = 0 robi przedmiot jednorazowy.
        Komunikat zmienisz lub wy\u0142\u0105czysz w \"Po Zebraniu\"."
      objectReference: {fileID: 0}
